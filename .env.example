# ---------- Development ----------
# `npm run dev` needs no variables: no login, data stays in localStorage.

# ---------- Production (Vercel) ----------
# Browser (public, safe to expose): Google OAuth Web client id
VITE_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Server only (Vercel -> Settings -> Environment Variables, never commit real values):
# GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
# ADMIN_EMAILS=jisraelevich@gmail.com,irisnoeliaruiz@gmail.com
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# DATA_ENCRYPTION_KEY=64_hex_characters
# BLOB_READ_WRITE_TOKEN is added automatically when you connect a Vercel Blob store to the project
